public class Song1
{
    private string title;
    private string artist;
    private int duration;
    private bool isFavorite;

    public string Title
    {
        get { return title; }
        set { title = value; }
    }

    public string Artist
    {
        get { return artist; }
        set { artist = value; }
    }

    public int Duration
    {
        get { return duration; }
        set { duration = value; }
    }

    public bool IsFavorite
    {
        get { return isFavorite; }
        set { isFavorite = value; }
    }
}
internal class ProgramSong
{
    public static Node<Song1> OrganizePlaylist(Node<Song1> list)
    {
        // רשימה חדשה לשירים מועדפים
        Node<Song1> favHead = null;
        Node<Song1> favTail = null;

        // רשימה חדשה לשירים לא מועדפים
        Node<Song1> otherHead = null;
        Node<Song1> otherTail = null;

        Node<Song1> current = list;

        // מעבר על הרשימה המקורית
        while (current != null)
        {
            Song1 s = current.GetValue();
            Node<Song1> newNode = new Node<Song1>(s); // יצירת חוליה חדשה

            if (s.IsFavorite)
            {
                // הוספה לסוף רשימת המועדפים
                if (favHead == null)
                    favHead = favTail = newNode;
                else
                {
                    favTail.SetNext(newNode);
                    favTail = newNode;
                }
            }
            else
            {
                // הוספה לסוף רשימת הלא-מועדפים
                if (otherHead == null)
                    otherHead = otherTail = newNode;
                else
                {
                    otherTail.SetNext(newNode);
                    otherTail = newNode;
                }
            }

            current = current.GetNext();
        }

        // חיבור שתי הרשימות
        if (favHead == null)
            return otherHead;

        favTail.SetNext(otherHead);
        return favHead;
    }
}

