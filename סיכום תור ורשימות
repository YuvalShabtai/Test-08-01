/***********************
 * פעולות של Node<T>
 ***********************/

// GetValue()
// מחזירה את הערך השמור בצומת
T GetValue();

// SetValue(x)
// משנה את הערך של הצומת לערך x
void SetValue(T x);

// GetNext()
// מחזירה מצביע לצומת הבא ברשימה
Node<T> GetNext();

// SetNext(node)
// מחברת את הצומת הנוכחי לצומת הבא node
void SetNext(Node<T> node);

// HasNext()
// מחזירה true אם יש צומת הבא, אחרת false
bool HasNext();



/***********************
 * פעולות של Queue<T>
 ***********************/

// Insert(x)
// מוסיפה איבר x לסוף התור
// (FIFO – הראשון שנכנס, הראשון שיוצא)
void Insert(T x);

// Remove()
// מסירה ומחזירה את האיבר שבראש התור
// אם התור ריק – מחזירה ערך ברירת מחדל
T Remove();

// Head()
// מחזירה את האיבר שבראש התור
// בלי להסיר אותו
T Head();

// IsEmpty()
// מחזירה true אם התור ריק
bool IsEmpty();
